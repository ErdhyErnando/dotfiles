[Unit]
Description=Sync tmux catppuccin theme with the GNOME dark/light toggle
# Runs for the length of the graphical session.
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/tmux-theme-sync.sh watch
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
